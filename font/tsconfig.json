{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "module": "esnext",
    "target": "ES2015",
    "declaration": true,
    "moduleResolution": "node",
    "allowJs": true,
    "outDir": "./dist/",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}